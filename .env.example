# Regulon environment overrides.
# Every value has a sane default; nothing here is required for the local-first path.
# Settings use the REGULON_ prefix and override config/regulon.yaml.

# Runtime environment name: dev | ci | prod
REGULON_ENVIRONMENT=dev

# Root directory for local data (knowledge base, queues, audit log)
REGULON_DATA_DIR=./data

# --- Arrives in a later milestone ---
# OLLAMA_HOST=http://localhost:11434        # M3: local model server

# There are deliberately no API-key variables in this file. Regulon runs entirely on local,
# free software: no accounts, no sign-ups, no metered services. The model gateway (M3) ships
# a generic adapter interface, so you can point it at any endpoint you already have — but
# nothing in the project requires one.
